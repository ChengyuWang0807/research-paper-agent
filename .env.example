RPA_MODEL=qwen3.6-35b-a3b
RPA_EMBEDDING_MODEL=qwen3-embedding-8b
RPA_RERANKER_MODEL=qwen3-reranker-8b
RPA_MAX_PAPER_WORKERS=3
# 02 semantic index is opt-in. The embedding service must expose /v1/embeddings.
RPA_ENABLE_SEMANTIC_INDEX=false
RPA_EMBEDDING_BASE_URL=
RPA_EMBEDDING_API_KEY=
RPA_ZVEC_ROOT=data/literature/zvec
RPA_DSH_PROVIDER=deepseek-official
RPA_DSH_MODEL=deepseek-v4-flash
RPA_DSH_TIMEOUT_SECONDS=900
# Optional custom Cordis composition. Leave empty to use the SDK default.
RPA_DSH_CORDIS=
# Optional generic provider overrides. For the current PyPI SDK, the verified
# Qwen/vLLM route uses the built-in DeepSeek protocol adapter:
# DEEPSEEK_API_KEY=vllm-local
# DEEPSEEK_BASE_URL=https://ai-platform-service-deploy.agentsocean.com/innova-gateway/image-deployment/jiaosc1/qwen36-35b-a3b/v1
# RPA_DSH_PROVIDER=deepseek-official
# RPA_DSH_MODEL=qwen36-35b-a3b
# RPA_DSH_MAX_TOKENS=8192
# For a DSH runtime containing dsh-llm-pi-ai, the custom route can instead use:
# RPA_DSH_PROVIDER=qwen-vllm
# RPA_DSH_API_KEY_ENV=RPA_VLLM_API_KEY
# RPA_DSH_CORDIS=config/dsh/qwen-vllm.cordis.yml
# DEEPSEEK_API_KEY=replace-me
